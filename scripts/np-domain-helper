#!/usr/bin/env bash
# /usr/local/sbin/np-domain-helper
# Secure root-owned helper for Nothing Panel domain and tunnel management
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Input sanitization regexes
UUID_REGEX='^[a-zA-Z0-9_-]{1,64}$'
DOMAIN_REGEX='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$'
TOKEN_REGEX='^[A-Za-z0-9=_-]{20,2048}$'

ACTION="${1:-}"
SERVER_UUID="${2:-}"

log_msg() {
    echo "$*"
}

error_exit() {
    echo "ERROR: $*" >&2
    exit 1
}

# Require action and server UUID
[ -n "$ACTION" ] || error_exit "Action required (add-nginx, delete-nginx, add-cf, delete-cf, status-cf, set-hostname)"
[ -n "$SERVER_UUID" ] || error_exit "Server UUID required"
[[ "$SERVER_UUID" =~ $UUID_REGEX ]] || error_exit "Invalid Server UUID format"

mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/log/nginx /var/log/nothing /etc/nothing/tunnels
chown root:www-data /etc/nothing /etc/nothing/tunnels 2>/dev/null || true
chmod 750 /etc/nothing /etc/nothing/tunnels 2>/dev/null || true
chmod 700 /var/log/nothing 2>/dev/null || true

# Helper to find panel's own domain to prevent collision/hijack
get_panel_domains() {
    local panel_domains=""
    for cfg in /etc/nginx/sites-available/*.conf /etc/nginx/sites-enabled/*.conf; do
        if [ -f "$cfg" ] && [[ "$cfg" != *"np-srv-"* ]] && [[ "$cfg" != *"np-port-"* ]]; then
            local doms
            doms=$(grep -E '^\s*server_name\s+' "$cfg" 2>/dev/null | sed -E 's/^\s*server_name\s+//; s/;//g' | tr ' ' '\n' | grep -v -E '^(localhost|_|\$host)' || true)
            panel_domains="${panel_domains} ${doms}"
        fi
    done
    echo "$panel_domains"
}

case "$ACTION" in
    add-nginx)
        DOMAIN="${3:-}"
        PORT="${4:-}"
        ENABLE_SSL="${5:-0}"

        [ -n "$DOMAIN" ] || error_exit "Domain required"
        [ -n "$PORT" ] || error_exit "Port required"
        [[ "$DOMAIN" =~ $DOMAIN_REGEX ]] || error_exit "Invalid domain name format"
        [[ "$PORT" =~ ^[0-9]+$ ]] && [ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || error_exit "Port must be an integer between 1024 and 65535"

        # Check against panel's own domain
        PANEL_DOMAINS=$(get_panel_domains)
        for pd in $PANEL_DOMAINS; do
            if [ "$DOMAIN" = "$pd" ]; then
                error_exit "Cannot map domain: '$DOMAIN' is reserved for Nothing Panel itself"
            fi
        done

        # Check for duplicate mapping across other servers
        for existing in /etc/nginx/sites-available/np-srv-*.conf /etc/nginx/sites-available/np-port-*.conf; do
            if [ -f "$existing" ]; then
                if grep -qw "$DOMAIN" "$existing" 2>/dev/null; then
                    if [[ "$existing" != *"/np-srv-${SERVER_UUID}-port-${PORT}.conf" ]] && [[ "$existing" != *"/np-port-${PORT}.conf" ]]; then
                        error_exit "Domain '$DOMAIN' is already mapped to another server or port"
                    fi
                fi
            fi
        done

        CONF_FILE="/etc/nginx/sites-available/np-srv-${SERVER_UUID}-port-${PORT}.conf"
        LINK_FILE="/etc/nginx/sites-enabled/np-srv-${SERVER_UUID}-port-${PORT}.conf"
        BAK_FILE="/tmp/np-backup-${SERVER_UUID}-${PORT}.conf"

        [ -f "$CONF_FILE" ] && cp "$CONF_FILE" "$BAK_FILE"

        cat << NGINX_CONF > "$CONF_FILE"
# Nothing Panel - Server ${SERVER_UUID} Port ${PORT}
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    access_log /var/log/nginx/np-srv-${SERVER_UUID}-port-${PORT}.access.log;
    error_log  /var/log/nginx/np-srv-${SERVER_UUID}-port-${PORT}.error.log error;
}
NGINX_CONF
        chmod 644 "$CONF_FILE"
        ln -sf "$CONF_FILE" "$LINK_FILE"

        # Test Nginx with automatic rollback
        if ! nginx -t 2>/dev/null; then
            rm -f "$LINK_FILE" "$CONF_FILE"
            if [ -f "$BAK_FILE" ]; then
                mv "$BAK_FILE" "$CONF_FILE"
                ln -sf "$CONF_FILE" "$LINK_FILE"
                nginx -t 2>/dev/null || rm -f "$LINK_FILE" "$CONF_FILE"
            fi
            error_exit "Nginx syntax test failed after adding domain. Configuration rolled back."
        fi
        rm -f "$BAK_FILE"

        # Reload Nginx
        systemctl reload nginx 2>/dev/null || nginx -s reload 2>/dev/null || true

        # Optional SSL Setup with DNS Pre-check
        SSL_MSG=""
        if [ "$ENABLE_SSL" = "1" ] || [ "$ENABLE_SSL" = "true" ]; then
            # DNS Pre-check: Verify domain points to this server
            SERVER_IP=$(curl -4 -fsSL https://api.ipify.org 2>/dev/null || curl -4 -fsSL https://icanhazip.com 2>/dev/null || echo "")
            RESOLVED_IP=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1; exit}' || echo "")

            if [ -n "$SERVER_IP" ] && [ -n "$RESOLVED_IP" ] && [ "$SERVER_IP" != "$RESOLVED_IP" ]; then
                SSL_MSG=" (HTTP active. DNS pre-check notice: '$DOMAIN' points to $RESOLVED_IP, server IP is $SERVER_IP. Update DNS A record before SSL can be issued.)"
            elif command -v certbot >/dev/null 2>&1; then
                if certbot --nginx --redirect --non-interactive --agree-tos --register-unsafely-without-email -d "$DOMAIN" >/dev/null 2>&1; then
                    SSL_MSG=" with SSL (HTTPS) enabled"
                else
                    SSL_MSG=" (HTTP active. SSL pending DNS propagation or certbot challenge.)"
                fi
            fi
        fi

        log_msg "SUCCESS: Domain '$DOMAIN' successfully mapped to Port $PORT${SSL_MSG}"
        ;;

    delete-nginx)
        PORT="${3:-}"
        [ -n "$PORT" ] || error_exit "Port required"
        [[ "$PORT" =~ ^[0-9]+$ ]] || error_exit "Invalid port format"

        CONF_FILE="/etc/nginx/sites-available/np-srv-${SERVER_UUID}-port-${PORT}.conf"
        LINK_FILE="/etc/nginx/sites-enabled/np-srv-${SERVER_UUID}-port-${PORT}.conf"
        LEGACY_CONF="/etc/nginx/sites-available/np-port-${PORT}.conf"
        LEGACY_LINK="/etc/nginx/sites-enabled/np-port-${PORT}.conf"

        for cf in "$CONF_FILE" "$LEGACY_CONF"; do
            if [ -f "$cf" ]; then
                DOM=$(grep -E '^\s*server_name\s+' "$cf" 2>/dev/null | sed -E 's/^\s*server_name\s+//; s/;//g' | awk '{print $1}' || true)
                if [ -n "$DOM" ] && command -v certbot >/dev/null 2>&1; then
                    certbot delete --cert-name "$DOM" --non-interactive >/dev/null 2>&1 || true
                fi
            fi
        done

        rm -f "$LINK_FILE" "$CONF_FILE" "$LEGACY_LINK" "$LEGACY_CONF"
        nginx -t 2>/dev/null && (systemctl reload nginx 2>/dev/null || nginx -s reload 2>/dev/null || true)
        log_msg "SUCCESS: Nginx port mapping for Port $PORT deleted"
        ;;

    add-cf)
        PORT="${3:-}"
        # Token is passed securely via stdin (or arg 4 for CLI testing) to prevent ps aux token leakage
        TOKEN="${4:-}"
        if [ -z "$TOKEN" ] && [ ! -t 0 ]; then
            IFS= read -r TOKEN || TOKEN=""
        fi
        TOKEN=$(echo "$TOKEN" | tr -d '\r\n[:space:]')

        [ -n "$PORT" ] || error_exit "Port required"
        [[ "$PORT" =~ ^[0-9]+$ ]] && [ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || error_exit "Port must be an integer between 1024 and 65535"
        [ -n "$TOKEN" ] || error_exit "Cloudflare tunnel token is required"

        # Validate token: base64-encoded JSON containing keys a, t, s
        if ! python3 -c '
import sys, base64, json
token = sys.argv[1].strip()
try:
    missing_padding = len(token) % 4
    if missing_padding:
        token += "=" * (4 - missing_padding)
    decoded = base64.b64decode(token).decode("utf-8")
    data = json.loads(decoded)
    if isinstance(data, dict) and "a" in data and "t" in data and "s" in data:
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
' "$TOKEN" 2>/dev/null; then
            error_exit "Invalid Cloudflare Tunnel token (token must decode to JSON containing 'a', 't', and 's')"
        fi

        CF_BIN="/usr/local/bin/cloudflared"
        if [ ! -x "$CF_BIN" ]; then
            ARCH=$(uname -m)
            case "$ARCH" in
                x86_64|amd64) CF_ARCH="amd64" ;;
                aarch64|arm64) CF_ARCH="arm64" ;;
                *) error_exit "Unsupported CPU architecture for cloudflared: $ARCH" ;;
            esac
            TMP_CF=$(mktemp)
            if curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}" -o "$TMP_CF"; then
                chmod +x "$TMP_CF"
                mv -f "$TMP_CF" "$CF_BIN"
            else
                error_exit "cloudflared binary is missing and download failed. Please install cloudflared."
            fi
        fi

        SVC_NAME="np-cf-srv-${SERVER_UUID}-port-${PORT}"
        SVC_FILE="/etc/systemd/system/${SVC_NAME}.service"
        ENV_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.env"
        LOG_FILE="/var/log/nothing/cf-srv-${SERVER_UUID}-port-${PORT}.log"
        META_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.meta"

        # Stop existing service if running for this port
        systemctl stop "$SVC_NAME" 2>/dev/null || true
        rm -f "$LOG_FILE" "$META_FILE" "$ENV_FILE"

        # Store in root-only 0600 EnvironmentFile (no command execution possible)
        cat << EOF > "$ENV_FILE"
TUNNEL_TOKEN=${TOKEN}
EOF
        chmod 600 "$ENV_FILE"
        chown root:root "$ENV_FILE"

        cat << UNIT > "$SVC_FILE"
[Unit]
Description=Nothing Panel Cloudflare Tunnel (${SERVER_UUID} Port ${PORT})
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=${ENV_FILE}
ExecStart=${CF_BIN} tunnel --no-autoupdate run --token \${TUNNEL_TOKEN}
Restart=always
RestartSec=5
StandardOutput=append:${LOG_FILE}
StandardError=append:${LOG_FILE}

[Install]
WantedBy=multi-user.target
UNIT
        chmod 644 "$SVC_FILE"
        systemctl daemon-reload
        systemctl enable --now "$SVC_NAME" 2>&1

        TOKEN_MASKED="••••${TOKEN: -4}"
        STARTED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

        # Initial starting metadata
        cat << META > "$META_FILE"
{"type": "cloudflared", "domain": null, "hostname": null, "port": ${PORT}, "status": "starting", "pid": null, "started_at": "${STARTED_AT}", "token_masked": "${TOKEN_MASKED}", "error": null}
META
        chmod 644 "$META_FILE"
        chown root:www-data "$META_FILE" 2>/dev/null || true

        # Poll log file up to 20 seconds to detect hostname and connection status
        DETECTED_HOSTNAME=""
        IS_CONNECTED=0
        LAST_ERROR=""

        for _ in {1..40}; do
            sleep 0.5
            if [ -f "$LOG_FILE" ]; then
                PARSE_RESULT=$(python3 -c '
import sys, re, json
log_path = sys.argv[1]
target_port = int(sys.argv[2])

detected_hostname = None
is_connected = False
last_error = None

try:
    with open(log_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            if "Registered tunnel connection" in line:
                is_connected = True
            if "Updated to new configuration" in line:
                m = re.search(r"config=\"((?:\\.|[^\"\\])*)\"", line)
                if m:
                    try:
                        cfg_str = m.group(1).encode("utf-8").decode("unicode_escape")
                        cfg = json.loads(cfg_str)
                        ingress = cfg.get("ingress", [])
                        for rule in ingress:
                            h = rule.get("hostname")
                            svc = rule.get("service", "")
                            if h and (f":{target_port}" in svc or len(ingress) <= 2):
                                detected_hostname = h
                                break
                        if not detected_hostname and ingress:
                            for rule in ingress:
                                h = rule.get("hostname")
                                if h:
                                    detected_hostname = h
                                    break
                    except Exception:
                        pass
            if "ERR" in line or "failed to authenticate" in line.lower() or "unauthorized" in line.lower():
                last_error = line.strip()
except Exception:
    pass

print(json.dumps({
    "connected": is_connected,
    "hostname": detected_hostname,
    "error": last_error
}))
' "$LOG_FILE" "$PORT" 2>/dev/null || echo '{"connected":false,"hostname":null,"error":null}')

                IS_CONNECTED=$(echo "$PARSE_RESULT" | grep -o '"connected": *true' | wc -l || echo 0)
                DETECTED_HOSTNAME=$(python3 -c 'import sys, json; print(json.loads(sys.argv[1]).get("hostname") or "")' "$PARSE_RESULT" 2>/dev/null || echo "")
                LAST_ERROR=$(python3 -c 'import sys, json; print(json.loads(sys.argv[1]).get("error") or "")' "$PARSE_RESULT" 2>/dev/null || echo "")

                # If connected and hostname detected, we can finish polling early
                if [ "$IS_CONNECTED" -ge 1 ] && [ -n "$DETECTED_HOSTNAME" ]; then
                    break
                fi
            fi

            # Check if process died prematurely
            if ! systemctl is-active --quiet "$SVC_NAME" 2>/dev/null; then
                LAST_ERROR="Process terminated unexpectedly. Check credentials or logs."
                break
            fi
        done

        CF_PID=$(systemctl show -p MainPID --value "$SVC_NAME" 2>/dev/null || echo "")
        [ "$CF_PID" = "0" ] && CF_PID=""

        STATUS="starting"
        if [ "$IS_CONNECTED" -ge 1 ]; then
            STATUS="connected"
        elif ! systemctl is-active --quiet "$SVC_NAME" 2>/dev/null || [ -n "$LAST_ERROR" ]; then
            STATUS="failed"
        fi

        # Write final metadata
        python3 -c '
import sys, json
meta = {
    "type": "cloudflared",
    "domain": sys.argv[1] if sys.argv[1] else None,
    "hostname": sys.argv[1] if sys.argv[1] else None,
    "port": int(sys.argv[2]),
    "status": sys.argv[3],
    "pid": int(sys.argv[4]) if sys.argv[4].isdigit() else None,
    "started_at": sys.argv[5],
    "token_masked": sys.argv[6],
    "error": sys.argv[7] if sys.argv[7] else None
}
with open(sys.argv[8], "w", encoding="utf-8") as f:
    json.dump(meta, f, indent=2)
' "$DETECTED_HOSTNAME" "$PORT" "$STATUS" "${CF_PID:-null}" "$STARTED_AT" "$TOKEN_MASKED" "$LAST_ERROR" "$META_FILE"

        chmod 644 "$META_FILE"
        chown root:www-data "$META_FILE" 2>/dev/null || true

        if [ "$STATUS" = "failed" ]; then
            error_exit "Cloudflare tunnel failed to start: ${LAST_ERROR:-Check token permissions}"
        fi

        if [ -n "$DETECTED_HOSTNAME" ]; then
            log_msg "SUCCESS: Cloudflare Tunnel active at https://${DETECTED_HOSTNAME} (routing to Port $PORT)"
        else
            log_msg "SUCCESS: Cloudflare Tunnel connected for Port $PORT (hostname will be detected or can be set manually)"
        fi
        ;;

    set-hostname)
        PORT="${3:-}"
        NEW_HOSTNAME="${4:-}"
        [ -n "$PORT" ] || error_exit "Port required"
        [ -n "$NEW_HOSTNAME" ] || error_exit "Hostname required"
        [[ "$NEW_HOSTNAME" =~ $DOMAIN_REGEX ]] || error_exit "Invalid hostname format"

        META_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.meta"
        [ -f "$META_FILE" ] || error_exit "Tunnel metadata not found for port $PORT"

        python3 -c '
import sys, json
meta_file = sys.argv[1]
new_host = sys.argv[2]
try:
    with open(meta_file, "r", encoding="utf-8") as f:
        data = json.load(f)
    data["domain"] = new_host
    data["hostname"] = new_host
    with open(meta_file, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
except Exception as e:
    sys.exit(1)
' "$META_FILE" "$NEW_HOSTNAME"

        chmod 644 "$META_FILE"
        chown root:www-data "$META_FILE" 2>/dev/null || true
        log_msg "SUCCESS: Hostname updated to ${NEW_HOSTNAME}"
        ;;

    delete-cf)
        PORT="${3:-}"
        [ -n "$PORT" ] || error_exit "Port required"
        SVC_NAME="np-cf-srv-${SERVER_UUID}-port-${PORT}"
        SVC_FILE="/etc/systemd/system/${SVC_NAME}.service"
        ENV_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.env"
        META_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.meta"
        LOG_FILE="/var/log/nothing/cf-srv-${SERVER_UUID}-port-${PORT}.log"

        LEGACY_SVC="np-cf-tunnel-${PORT}"
        LEGACY_FILE="/etc/systemd/system/${LEGACY_SVC}.service"

        systemctl stop "$SVC_NAME" "$LEGACY_SVC" 2>/dev/null || true
        systemctl disable "$SVC_NAME" "$LEGACY_SVC" 2>/dev/null || true
        rm -f "$SVC_FILE" "$ENV_FILE" "$META_FILE" "$LOG_FILE" "$LEGACY_FILE" "/var/log/cf-tunnel-${PORT}.meta" "/var/log/cf-tunnel-${PORT}.log"
        systemctl daemon-reload 2>/dev/null || true
        pkill -f "cloudflared.*${PORT}" 2>/dev/null || true
        log_msg "SUCCESS: Cloudflare Tunnel for Port $PORT stopped and removed"
        ;;

    status-cf)
        PORT="${3:-}"
        SVC_NAME="np-cf-srv-${SERVER_UUID}-port-${PORT}"
        META_FILE="/etc/nothing/tunnels/cf-srv-${SERVER_UUID}-port-${PORT}.meta"
        LOG_FILE="/var/log/nothing/cf-srv-${SERVER_UUID}-port-${PORT}.log"

        if systemctl is-active --quiet "$SVC_NAME" 2>/dev/null; then
            # If active, check if hostname became known in the meantime
            if [ -f "$META_FILE" ] && [ -f "$LOG_FILE" ]; then
                python3 -c '
import sys, re, json
meta_file = sys.argv[1]
log_path = sys.argv[2]
target_port = int(sys.argv[3])
try:
    with open(meta_file, "r") as f:
        meta = json.load(f)
    if not meta.get("hostname") or meta.get("status") != "connected":
        detected = None
        with open(log_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if "Updated to new configuration" in line:
                    m = re.search(r"config=\"((?:\\.|[^\"\\])*)\"", line)
                    if m:
                        cfg = json.loads(m.group(1).encode("utf-8").decode("unicode_escape"))
                        for rule in cfg.get("ingress", []):
                            h = rule.get("hostname")
                            svc = rule.get("service", "")
                            if h and (f":{target_port}" in svc or len(cfg.get("ingress", [])) <= 2):
                                detected = h
                                break
        if detected:
            meta["hostname"] = detected
            meta["domain"] = detected
            meta["status"] = "connected"
            with open(meta_file, "w") as f:
                json.dump(meta, f, indent=2)
except Exception:
    pass
' "$META_FILE" "$LOG_FILE" "$PORT" 2>/dev/null || true
            fi
            echo "active"
        else
            # Mark failed/stopped in meta if not already
            if [ -f "$META_FILE" ]; then
                python3 -c '
import sys, json
meta_file = sys.argv[1]
try:
    with open(meta_file, "r") as f:
        meta = json.load(f)
    if meta.get("status") not in ["failed", "stopped"]:
        meta["status"] = "stopped"
        with open(meta_file, "w") as f:
            json.dump(meta, f, indent=2)
except Exception:
    pass
' "$META_FILE" 2>/dev/null || true
            fi
            echo "inactive"
        fi
        ;;

    *)
        error_exit "Unknown action '$ACTION'"
        ;;
esac

exit 0
